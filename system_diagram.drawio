                <mxCell id="297" value="&lt;font&gt;&lt;span style=&quot;font-size: 30px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;Python Data Analysis: Matplotlib visualisation&lt;/span&gt;&lt;/font&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#33FF99,#FFFF00);fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
                    <mxGeometry x="4542" y="-264" width="623" height="110" as="geometry"/>
