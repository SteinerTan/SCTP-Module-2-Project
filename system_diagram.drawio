                <mxCell id="24" value="&lt;font style=&quot;font-size: 30px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;CSV Data Extraction from Kaggle&lt;/font&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#33FF99,#FFFF00);fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
                    <mxGeometry x="-819" y="-212" width="541" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="&lt;b&gt;&lt;u&gt;Rationale for dataset choices&lt;/u&gt;&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Customers - Provide key information on customer demographics to better understand consumption patterns across regions&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Order Item - Understand key information on the products, seller, buyer and pricing&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Order Payments: Understand the payment type and value, which can be used to calculate total revenue across a period of time&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Order: To identify the buyer and their consumption patterns across a period of time.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Products: Categorize the products to identify the loss leaders, declining products, growth products, mature products, breakthrough products. This can help us make a better decision on what to do with products in the future - To stockpile, to invest, to hold, to offload or to exit entirely.&lt;/div&gt;" style="shape=ext;double=1;rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#33FF99,#FFFF00);align=left;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;fontSize=20;fontColor=light-dark(#000000,#000000);" parent="1" vertex="1">
                    <mxGeometry x="-1215" y="760" width="780" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="&lt;font style=&quot;font-size: 30px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;SQL dbt Transformation&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 30px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;using STAR Schema&lt;/font&gt;&lt;/div&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#33FF99,#FFFF00);fontColor=#ffffff;strokeColor=light-dark(#000000,#000000);" parent="1" vertex="1">
                    <mxGeometry x="1947" y="-220" width="460" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="&lt;span id=&quot;docs-internal-guid-b092603b-7fff-2da6-b448-1de427fd3811&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 12pt;&quot;&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span id=&quot;docs-internal-guid-30d9dbac-7fff-a13f-a0da-4796fb0790e7&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height: 1.38; margin-top: 0pt; margin-bottom: 12pt;&quot;&gt;&lt;span style=&quot;font-size: 28pt; font-family: Lato, sans-serif; background-color: transparent; font-variant: normal; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Leverage historical transaction data to identify popular products, match consumers with relevant sellable inventory, and increase visibility to drive sustained platform engagement and profitability&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 28pt; font-family: Lato, sans-serif; background-color: transparent; font-variant: normal; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;gradientColor=none;fillColor=light-dark(#33FF99,#FFFF00);strokeColor=light-dark(#000000,#000000);verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="1463" y="-480" width="1863" height="187" as="geometry"/>
                </mxCell>
