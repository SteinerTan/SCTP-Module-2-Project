                <mxCell id="322" value="&lt;font style=&quot;font-size: 30px; color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;Use of Meltano ELT to get data to Google Bigquery&lt;/font&gt;" style="shape=ext;double=1;rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#33FF99,#FFFF00);fontColor=#000000;strokeColor=#B09500;" parent="1" vertex="1">
